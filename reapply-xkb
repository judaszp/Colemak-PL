#!/usr/bin/env bash
set -euo pipefail

symbols=/usr/share/X11/xkb/symbols/us
rules=/usr/share/X11/xkb/rules/evdev.xml
marker='// BEGIN Colemak-PL'
[[ -f "$symbols" && -f "$rules" ]] || { echo 'XKB files not found' >&2; exit 1; }

if ! grep -Fq "$marker" "$symbols"; then
  cat >> "$symbols" <<'XKB'

// BEGIN Colemak-PL
partial alphanumeric_keys
xkb_symbols "colemak_pl" {
    include "us(colemak)"
    name[Group1] = "Colemak-PL";
    key <BKSP> { [ Caps_Lock ] };
};
// END Colemak-PL
XKB
fi

python - "$rules" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
content = path.read_text()

layout_pattern = re.compile(r"<layout>.*?</layout>", re.S)
variant_pattern = re.compile(
    r"<variant>\s*<configItem>\s*<name>\s*colemak_pl\s*</name>\s*"
    r"<description>\s*Colemak-PL\s*</description>\s*</configItem>\s*</variant>",
    re.S,
)
entry = '''        <variant>
          <configItem>
            <name>colemak_pl</name>
            <description>Colemak-PL</description>
          </configItem>
        </variant>
'''
found_us = False

def fix_layout(match):
    global found_us
    block = match.group()
    header = re.match(r"\s*<layout>\s*<configItem>(.*?)</configItem>", block, re.S)
    layout_name = re.search(r"<name>\s*(.*?)\s*</name>", header.group(1), re.S) if header else None
    if not layout_name:
        return block

    is_us = layout_name.group(1).strip() == "us"
    if is_us:
        found_us = True

    variants = list(variant_pattern.finditer(block))
    if not is_us:
        return variant_pattern.sub("", block)

    # Keep one correct entry under US, remove duplicates, and repair earlier
    # installs that accidentally placed the variant under another layout.
    if variants:
        for duplicate in reversed(variants[1:]):
            block = block[:duplicate.start()] + block[duplicate.end():]
        return block

    closing = "</variantList>"
    if closing not in block:
        raise SystemExit("US XKB layout has no variantList")
    return block.replace(closing, entry + "        " + closing, 1)

content = layout_pattern.sub(fix_layout, content)
if not found_us:
    raise SystemExit("Could not find the US XKB layout")
path.write_text(content)
PY

localectl set-x11-keymap us pc105 colemak_pl
